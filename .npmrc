# Lifecycle scripts are how a compromised package gets to run code on your
# machine the moment you install. Nothing here needs them: the only dependency
# with an install script is fsevents, which is an optional macOS file watcher
# that Vite happily does without.
ignore-scripts=true

# New installs pin an exact version rather than a caret range, so the lockfile
# stays the single source of truth about what gets executed.
save-exact=true

engine-strict=true
fund=false
